rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ملاحظة: Firestore يرفض افتراضياً أي مسار لا تطابقه قاعدة صريحة، ولا حاجة
    // إلى قاعدة `match /{document=**} { allow read, write: if false; }` — فالقواعد
    // تُجمع بمنطق "أو"، أي أن قاعدة رفض لا تُلغي سماحاً في مسار آخر، فتوحي بحماية
    // لا تقدّمها. الحماية الحقيقية هي أن كل مسار أدناه يذكر شرطه بنفسه.

    // ===================== الهوية والصلاحيات =====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function subUserRef(ownerId, helperId) {
      return /databases/$(database)/documents/users/$(ownerId)/subUsers/$(helperId);
    }

    // المساعد: مَن أدرجه المالك في مجموعته الخاصة subUsers.
    function isSubUserOf(userId) {
      return isSignedIn() && exists(subUserRef(userId, request.auth.uid));
    }

    // المشرف: مَن يملك سجل هذا المستخدم داخل مجموعته هو. هذه هي نقطة الارتكاز
    // التي تمنع انتحال الإشراف: لا أحد يكتب في subUsers الخاصة بغيره، فلا أحد
    // يستطيع أن يعلن نفسه مشرفاً على مستخدم لم ينشئه.
    function isAdminOf(userId) {
      return isSignedIn() && exists(subUserRef(request.auth.uid, userId));
    }

    function canAccessUser(userId) {
      return isOwner(userId) || isSubUserOf(userId);
    }

    function helperTabs(userId) {
      return get(subUserRef(userId, request.auth.uid)).data.get('allowedTabs', []);
    }

    // القراءة تتبع أي تبويب يعرض هذه البيانات (لوحة التحكم والتقارير تقرأ كل شيء)،
    // بينما الكتابة تتبع تبويب التحرير وحده. المالك لا يمرّ بأي من الفحصين، فلا
    // تُحتسب عليه قراءات إضافية.
    function canReadTabs(userId, tabs) {
      return isOwner(userId) || (isSubUserOf(userId) && helperTabs(userId).hasAny(tabs));
    }

    function canWriteTab(userId, tab) {
      return isOwner(userId) || (isSubUserOf(userId) && tab in helperTabs(userId));
    }

    // المستخدم العادي لا يمسّ حقول الإشراف: لا يمنح نفسه مشرفاً ولا يوسّع تبويباته.
    function keepsSupervisionFields(userId) {
      return incoming().get('adminId', null) == existing().get('adminId', null)
             && incoming().get('allowedTabs', null) == existing().get('allowedTabs', null);
    }

    // فكّ حَبس. ملفٌ يحمل adminId بلا سجل subUsers مقابل لا يستطيع مالكه تعديله
    // (الشرط أعلاه يُلزمه بإبقاء adminId) ولا مشرفُه المزعوم (isAdminOf يكذّبه)،
    // فيبقى الحساب معطّلاً إلى الأبد: الواجهة توجّه بياناته إلى حساب المشرف
    // الوهمي فتُرفض كل قراءة وكتابة. تنشأ هذه الحالة من زرعٍ عبر الثغرة المغلقة،
    // أو من إنشاء مساعد بالترتيب القديم قبل إصلاح PermissionsManager.
    //
    // المسموح هنا إزالة الإشراف وحدها — لا إضافته ولا تحويله إلى آخر — وفقط حين
    // يكون الارتباط معلّقاً فعلاً. فالمساعد الحقيقي لا يفكّ ارتباطه بنفسه، ومَن
    // يفكّه لا يكسب شيئاً: صلاحيات المساعد تُشتق من سجل subUsers عند المالك لا
    // من هذا الحقل، فالفكّ نزولٌ إلى حساب فارغ لا ترقية.
    function releasesDanglingSupervision(userId) {
      return existing().get('adminId', null) != null
             && incoming().get('adminId', null) == null
             && !exists(subUserRef(existing().adminId, userId));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAttachments(data) {
      return !('attachments' in data) ||
             (data.attachments is list && data.attachments.size() <= 10);
    }

    // ===================== مخططات التحقق من البيانات =====================

    function isValidUserProfile(data) {
      return data.keys().hasAll(['userId', 'displayName']) &&
             data.userId is string && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 200 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 256)) &&
             (!('phoneNumber' in data) || (data.phoneNumber is string && data.phoneNumber.size() <= 50)) &&
             (!('currency' in data) || (data.currency is string && data.currency.size() <= 10)) &&
             (!('adminId' in data) || (data.adminId is string && data.adminId.size() <= 128)) &&
             (!('allowedTabs' in data) || (data.allowedTabs is list && data.allowedTabs.size() <= 20));
    }

    function isValidDebt(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'type', 'personName', 'amount', 'paidAmount', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             (data.type == 'to_me' || data.type == 'to_others') &&
             data.personName is string && data.personName.size() <= 200 &&
             (data.status == 'paid' || data.status == 'partial' || data.status == 'unpaid') &&
             data.amount is number && data.amount >= 0 &&
             data.paidAmount is number && data.paidAmount >= 0 &&
             (!('dueDate' in data) || (data.dueDate is string && data.dueDate.size() <= 100)) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 100)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128)) &&
             (!('installments' in data) || (data.installments is list && data.installments.size() <= 100)) &&
             isValidAttachments(data);
    }

    // تصنيفات الدخل مغلقة على قائمة معروفة: حقل نصّي حر يجعل التقارير بلا معنى،
    // ويفتح باباً لحشو نصوص طويلة في مستند يُقرأ في كل تحميل.
    function isValidIncomeCategory(category) {
      return category in ['salary', 'daily', 'sale', 'rent', 'gift', 'other'];
    }

    function isValidIncome(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'category', 'date']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.amount is number && data.amount >= 0 &&
             isValidIncomeCategory(data.category) &&
             data.date is string && data.date.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('sourceId' in data) || (data.sourceId is string && data.sourceId.size() <= 128)) &&
             (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128));
    }

    function isValidIncomeSource(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'amount', 'category', 'cadence', 'isActive']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.amount is number && data.amount >= 0 &&
             isValidIncomeCategory(data.category) &&
             data.cadence in ['monthly', 'daily'] &&
             data.isActive is bool &&
             // يوم الاستحقاق محصور بـ 28 فلا ينكسر المصدر في فبراير
             (!('dayOfMonth' in data) || (data.dayOfMonth is int && data.dayOfMonth >= 1 && data.dayOfMonth <= 28)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             (!('lastCollectedDate' in data) || (data.lastCollectedDate is string && data.lastCollectedDate.size() <= 100));
    }

    function isValidExpense(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'amount', 'category', 'date']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.amount is number && data.amount >= 0 &&
             data.category is string && data.category.size() <= 100 &&
             data.date is string && data.date.size() <= 100 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('linkedDebtId' in data) || (data.linkedDebtId is string && data.linkedDebtId.size() <= 128)) &&
             (!('projectId' in data) || (data.projectId is string && data.projectId.size() <= 128)) &&
             (!('note' in data) || (data.note is string && data.note.size() <= 1000)) &&
             isValidAttachments(data);
    }

    function isValidBudget(data, userId) {
      return data.keys().hasAll(['month', 'userId', 'monthlyLimit']) &&
             data.month is string && data.month.size() <= 20 &&
             data.userId == userId &&
             data.monthlyLimit is number && data.monthlyLimit >= 0 &&
             (!('categoryLimits' in data) || (data.categoryLimits is map));
    }

    function isValidProject(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'name', 'budget', 'debtCeiling', 'status']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.name is string && data.name.size() <= 200 &&
             data.budget is number && data.budget >= 0 &&
             data.debtCeiling is number && data.debtCeiling >= 0 &&
             (data.status == 'active' || data.status == 'completed' || data.status == 'on_hold') &&
             (!('clientName' in data) || (data.clientName is string && data.clientName.size() <= 200)) &&
             (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 100)) &&
             (!('endDate' in data) || (data.endDate is string && data.endDate.size() <= 100)) &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidEmployee(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'projectId', 'name', 'salaryAmount']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.name is string && data.name.size() <= 200 &&
             data.salaryAmount is number && data.salaryAmount >= 0 &&
             (!('role' in data) || (data.role is string && data.role.size() <= 200)) &&
             (!('hireDate' in data) || (data.hireDate is string && data.hireDate.size() <= 100));
    }

    function isValidSalaryPayment(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'employeeId', 'projectId', 'amount', 'paymentDate', 'month']) &&
             data.id is string && data.id.size() <= 128 &&
             data.userId == userId &&
             data.employeeId is string && data.employeeId.size() <= 128 &&
             data.projectId is string && data.projectId.size() <= 128 &&
             data.amount is number && data.amount >= 0 &&
             data.paymentDate is string && data.paymentDate.size() <= 100 &&
             data.month is string && data.month.size() <= 20 &&
             (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000));
    }

    function isValidSubUser(data) {
      return data.keys().hasAll(['id', 'displayName', 'email', 'allowedTabs']) &&
             data.id is string && data.id.size() <= 128 &&
             data.displayName is string && data.displayName.size() <= 200 &&
             data.email is string && data.email.size() <= 256 &&
             data.allowedTabs is list && data.allowedTabs.size() <= 20 &&
             (!('createdAt' in data) || (data.createdAt is string && data.createdAt.size() <= 100));
    }

    // ===================== ملف المستخدم =====================

    match /users/{userId} {
      allow read: if canAccessUser(userId) || isAdminOf(userId);

      // الإنشاء: إمّا المستخدم نفسه لملفه الشخصي بلا مشرف، وإمّا مشرف أنشأ سجل
      // المساعد في مجموعته أولاً. لا يوجد مسار ثالث يسمح بإنشاء ملف لمعرّف
      // عشوائي، وهذا ما يغلق اختطاف الحساب.
      allow create: if isValidUserProfile(incoming()) && (
                      (isOwner(userId) && !('adminId' in incoming()))
                      ||
                      (isAdminOf(userId) && incoming().adminId == request.auth.uid)
                    );

      // التعديل: المستخدم يعدّل بياناته من دون المساس بـ adminId أو allowedTabs،
      // والمشرف يعدّل صلاحيات مساعده أو يفصله عنه. تُقرأ الحقول عبر get(...,null)
      // حتى لا تنفجر المقارنة لمستخدم بلا مشرف.
      allow update: if isValidUserProfile(incoming()) && (
                      (isOwner(userId) && (
                        keepsSupervisionFields(userId)
                        ||
                        releasesDanglingSupervision(userId)
                      ))
                      ||
                      (isAdminOf(userId)
                        && existing().get('adminId', null) == request.auth.uid
                        && incoming().get('adminId', '') in [request.auth.uid, ''])
                    );

      allow delete: if isOwner(userId)
                    || (isAdminOf(userId) && existing().get('adminId', null) == request.auth.uid);

      // ===================== السجلات المالية =====================
      // الحذف مفصول عن الإنشاء والتعديل عمداً: عند الحذف تكون request.resource
      // فارغة، فأي استدعاء لمخطط التحقق داخل قاعدة الحذف يفشل بخطأ null ويمنع
      // المستخدم من حذف بياناته هو.

      match /debts/{debtId} {
        allow read: if canReadTabs(userId, ['debts', 'dashboard', 'reports', 'alerts']);
        allow create, update: if canWriteTab(userId, 'debts')
                              && isValidId(debtId) && isValidDebt(incoming(), userId);
        allow delete: if canWriteTab(userId, 'debts');
      }

      match /expenses/{expenseId} {
        allow read: if canReadTabs(userId, ['budget', 'dashboard', 'reports', 'alerts']);
        allow create, update: if canWriteTab(userId, 'budget')
                              && isValidId(expenseId) && isValidExpense(incoming(), userId);
        allow delete: if canWriteTab(userId, 'budget');
      }

      // الدخل تبويب مستقل عن الميزانية عمداً: مَن يُؤتمن على تسجيل المصاريف
      // لا يُؤتمن بالضرورة على تعديل الوارد، والعكس. لوحة التحكم والتقارير
      // تقرأه لأن رأس المال لا يُحسب بدونه.
      match /incomes/{incomeId} {
        allow read: if canReadTabs(userId, ['income', 'budget', 'dashboard', 'reports', 'alerts']);
        allow create, update: if canWriteTab(userId, 'income')
                              && isValidId(incomeId) && isValidIncome(incoming(), userId);
        allow delete: if canWriteTab(userId, 'income');
      }

      match /incomeSources/{sourceId} {
        allow read: if canReadTabs(userId, ['income', 'dashboard', 'reports']);
        allow create, update: if canWriteTab(userId, 'income')
                              && isValidId(sourceId) && isValidIncomeSource(incoming(), userId);
        allow delete: if canWriteTab(userId, 'income');
      }

      match /budgets/{budgetId} {
        allow read: if canReadTabs(userId, ['budget', 'dashboard', 'reports', 'alerts']);
        allow create, update: if canWriteTab(userId, 'budget')
                              && isValidId(budgetId) && isValidBudget(incoming(), userId);
        allow delete: if canWriteTab(userId, 'budget');
      }

      match /projects/{projectId} {
        allow read: if canReadTabs(userId, ['projects', 'dashboard', 'reports']);
        allow create, update: if canWriteTab(userId, 'projects')
                              && isValidId(projectId) && isValidProject(incoming(), userId);
        allow delete: if canWriteTab(userId, 'projects');
      }

      match /employees/{employeeId} {
        allow read: if canReadTabs(userId, ['projects', 'dashboard', 'reports']);
        allow create, update: if canWriteTab(userId, 'projects')
                              && isValidId(employeeId) && isValidEmployee(incoming(), userId);
        allow delete: if canWriteTab(userId, 'projects');
      }

      match /salaryPayments/{paymentId} {
        allow read: if canReadTabs(userId, ['projects', 'dashboard', 'reports']);
        allow create, update: if canWriteTab(userId, 'projects')
                              && isValidId(paymentId) && isValidSalaryPayment(incoming(), userId);
        allow delete: if canWriteTab(userId, 'projects');
      }

      // إدارة المساعدين للمالك وحده. هذه المجموعة هي مصدر الثقة لكل ما سبق،
      // فلا يجوز أن يكتب فيها أحد سوى صاحب الحساب.
      match /subUsers/{subUserId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidId(subUserId) && isValidSubUser(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
